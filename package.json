{
  "name": "stella-sigil",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "pnpm --filter @stella/game dev",
    "build": "pnpm --filter @stella/game build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tools/tsconfig.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "validate:data": "node tools/scripts/validate-data.ts",
    "report:provisional": "node tools/scripts/report-provisional.ts",
    "sim": "pnpm --filter @stella/sim start",
    "smoke": "pnpm build && pnpm --filter @stella/game smoke",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm validate:data && pnpm build && pnpm report:provisional",
    "e2e": "pnpm --filter @stella/game e2e",
    "bench": "pnpm --filter @stella/game bench",
    "perf": "pnpm --filter @stella/game perf",
    "perf:browser": "pnpm --filter @stella/game perf:browser",
    "gen:star": "node tools/scripts/gen-star-mvp.ts",
    "report:star": "node tools/scripts/star-list.ts",
    "drops": "node tools/scripts/drop-rates.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
